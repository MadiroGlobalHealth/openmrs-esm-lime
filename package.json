{
  "name": "@madiro/openmrs-esm-lime",
  "version": "1.1.0",
  "private": true,
  "description": "LIME EMR microfrontends for the OpenMRS 3.x",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "openmrs develop --sources 'packages/esm-*-app/' --backend https://lime-mosul-uat.madiro.org",
    "ci:publish": "yarn workspaces foreach --all --topological --exclude @madiro/openmrs-esm-lime npm publish --access public --tag latest",
    "ci:prepublish": "yarn workspaces foreach --all --topological --exclude @madiro/openmrs-esm-lime npm publish --access public --tag next",
    "release": "yarn workspaces foreach --all --topological version",
    "verify": "turbo run lint typescript test --color --concurrency=2",
    "test-e2e": "playwright test",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@openmrs/esm-form-engine-lib": "next",
    "@openmrs/esm-framework": "next",
    "@openmrs/esm-patient-common-lib": "next",
    "@playwright/test": "1.45.3",
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.3.89",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/lodash-es": "^4.17.9",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/webpack-env": "^1.18.1",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.2",
    "babel-preset-minify": "^0.5.2",
    "concurrently": "^8.2.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jest-dom": "^5.4.0",
    "eslint-plugin-playwright": "^0.16.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^6.2.2",
    "happy-dom": "^20.0.0",
    "husky": "^8.0.3",
    "i18next": "^25.0.0",
    "i18next-parser": "^9.3.0",
    "identity-obj-proxy": "^3.0.0",
    "lint-staged": "^15.2.2",
    "lodash": "^4.17.21",
    "openmrs": "next",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.16.0",
    "rxjs": "^6.6.7",
    "swr": "^2.2.4",
    "turbo": "^2.5.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2",
    "webpack-dev-server": "^5.2.1"
  },
  "lint-staged": {
    "packages/**/src/**/*.{ts,tsx}": "eslint --cache --fix --max-warnings 0",
    "*.{css,scss,ts,tsx}": "prettier --cache --write --list-different"
  },
  "packageManager": "yarn@4.16.0"
}
