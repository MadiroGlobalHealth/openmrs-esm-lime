{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": [
      "dom",
      "es2015.promise",
      "es2015",
      "es2016.array.include",
      "es2018",
      "es2020",
      "es2021",
      "es2022",
      "es5",
      "scripthost",
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@openmrs/esm-styleguide/src/public": ["./node_modules/@openmrs/esm-styleguide/dist/public.d.ts"],
      "@openmrs/esm-styleguide/src/internal": ["./node_modules/@openmrs/esm-styleguide/dist/internal.d.ts"],
      "__mocks__": ["./__mocks__"],
      "tools": ["./tools"],
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./node_modules/testing-library"],
    "types": ["webpack-env", "node", "fhir"],
    "target": "esnext",
  }
}
